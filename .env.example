# Скопируйте этот файл в .env и заполните значениями из Supabase
# (Project Settings -> API). Используйте ТОЛЬКО anon/publishable key.
# service_role key во frontend использовать ЗАПРЕЩЕНО.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Необязательно: base path для GitHub Pages (по умолчанию "/").
# В GitHub Actions выставляется автоматически в "/<имя-репозитория>/".
# VITE_BASE_PATH=/coop-quest/
